{
  "worktree": {
    "setup": [
      "python3 -m venv .venv",
      ".venv/bin/python -m pip install -e \".[dev]\""
    ],
    "teardown": "echo \"Setup starts no persistent services; Paseo handles worktree removal.\""
  },
  "scripts": {
    "diff-check": {
      "command": "git diff --check"
    },
    "test": {
      "command": ".venv/bin/python -m pytest"
    }
  }
}
